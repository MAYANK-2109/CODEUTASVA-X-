# Copy to backend/.env and fill in. backend/.env is gitignored.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase (required for portfolio persistence from the backend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini key for the chat's planning and wording (aistudio.google.com/apikey).
# Without it the chat uses rule-based planning and template wording.
GEMINI_API_KEY=

# Optional - local/keyless fallbacks are used when empty
# Vector database for event search and news indexing (free key at pinecone.io).
# The index is created automatically on first start.
PINECONE_API_KEY=
NEWSAPI_KEY=
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
